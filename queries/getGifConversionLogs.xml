<query id="getGifConversionLogs" action="select">
	<tables>
		<table name="sticker_gif_conversion_log" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="status" var="status" pipe="and" />
		<condition operation="equal" column="sticker_srl" var="sticker_srl" filter="number" pipe="and" />
		<condition operation="equal" column="sticker_file_srl" var="sticker_file_srl" filter="number" pipe="and" />
	</conditions>
	<navigation>
		<index var="sort_index" default="last_update" order="order_type" />
		<list_count var="list_count" default="30" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
