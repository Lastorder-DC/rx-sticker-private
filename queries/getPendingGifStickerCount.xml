<query id="getPendingGifStickerCount" action="select">
	<tables>
		<table name="sticker_files" alias="sf" />
		<table name="sticker_gif_conversion_log" alias="gcl" type="left join">
			<conditions>
				<condition operation="equal" column="gcl.sticker_file_srl" default="sf.sticker_file_srl" />
			</conditions>
		</table>
	</tables>
	<columns>
		<column name="count(*)" alias="count" />
	</columns>
	<conditions>
		<condition operation="like_suffix" column="sf.url" var="ext" notnull="notnull" />
		<condition operation="null" column="gcl.sticker_file_srl" pipe="and" />
	</conditions>
</query>
